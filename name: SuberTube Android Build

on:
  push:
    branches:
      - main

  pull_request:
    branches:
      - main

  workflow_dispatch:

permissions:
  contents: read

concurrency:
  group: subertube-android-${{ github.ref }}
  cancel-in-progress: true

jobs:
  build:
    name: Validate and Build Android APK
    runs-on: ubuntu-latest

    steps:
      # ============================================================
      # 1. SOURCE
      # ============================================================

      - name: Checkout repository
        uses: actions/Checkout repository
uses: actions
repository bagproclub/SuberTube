# ============================================================
# SuberTube Android Build — Validate Only (Human Release Edition)
# วันที่: 2026-09-29
# หลักการ: ไฟล์นี้ใช้ VALIDATE/BUILD เท่านั้น — ไม่มี release, deploy,
#          ไม่มี secrets, ไม่ผูก URL/API ภายนอกใดๆ
# การปล่อยงานเป็นหน้าที่ของผู้ใช้ (กด Merge เอง) เสมอ
# ⚠️ กรอกชื่อไฟล์ ".github/workflows/android-build.yml" ในช่อง
#    "Name your file..." ก่อน Commit เท่านั้น
# ============================================================

name: SuberTube Android Build

on:
  push:
    branches: [main]
    paths:
      - 'android/**'
      - '.github/workflows/android-build.yml'
  pull_request:
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: subertube-android-${{ github.ref }}
  cancel-in-progress: true

jobs:
  validate:
    name: Validate Source
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Check no secrets in source tree
        run: |
          echo "== Scan for common secret patterns =="
          ! grep -rEni '(api[_-]?key|secret|token|password)\s*=\s*"[^"]+"' android/ || exit 1
          echo "PASS: no hardcoded secrets found"

      - name: Check canonical file structure
        run: |
          echo "== Verify canonical structure exists =="
          test -f android/app/src/main/AndroidManifest.xml
          test -f android/app/src/main/java/com/subertube/app/MainActivity.java
          test -f web/public/index.html
          test -f web/public/app.js
          echo "PASS: canonical structure OK"

      - name: Fail on malformed filenames
        run: |
          echo "== Scan for malformed file names =="
          BAD=$(git ls-files | grep -E ' \(1\)|^name: ' || true)
          if [ -n "$BAD" ]; then
            echo "FAIL: malformed filenames found:"
            echo "$BAD"
            exit 1
          fi
          echo "PASS: no malformed filenames"

  build:
    name: Build Debug APK
    needs: validate
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4

      - name: Build debug APK
        run: cd android && ./gradlew assembleDebug --stacktrace

      - name: Compute SHA256
        run: |
          APK=$(find android -name "*.apk" | head -1)
          sha256sum "$APK" | tee apk-sha256.txt
          echo "APK_PATH=$APK" >> "$GITHUB_ENV"

      - name: Upload artifact (build evidence only — NOT a release)
        uses: actions/upload-artifact@v4
        with:
          name: subertube-debug-apk
          path: |
            ${{ env.APK_PATH }}
            apk-sha256.txt
          retention-days: 90

# ไม่มีขั้น release/deploy — การปล่อยงานทำโดยผู้ใช้เท่านั้น
# HUMAN RELEASE APPROVAL: ผู้ใช้ตรวจ artifact + diff แล้วกด Merge เอง