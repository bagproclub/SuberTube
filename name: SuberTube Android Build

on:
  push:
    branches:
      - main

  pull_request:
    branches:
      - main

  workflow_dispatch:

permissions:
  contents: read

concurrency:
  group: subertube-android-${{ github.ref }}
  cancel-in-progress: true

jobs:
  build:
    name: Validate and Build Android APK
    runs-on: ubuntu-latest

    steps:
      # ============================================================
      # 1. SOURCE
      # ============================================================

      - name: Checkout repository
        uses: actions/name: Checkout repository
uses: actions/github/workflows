name: SuberTube CI/CD

on:
  push:
    branches: [main, develop]
  pull_request:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

permissions:
  contents: read

jobs:
  test:
    name: Checkout → Node → npm ci → Lint → Test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm
      - run: npm ci
      - name: Lint & Typecheck
        run: |
          npm run lint --if-present
          npm run typecheck --if-present
      - run: npm test

  security:
    name: Security Scan
    needs: test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      # ไม่ต้อง npm ci — npm audit ใช้ package-lock.json อย่างเดียว
      - name: Dependency vulnerability scan
        run: npm audit --audit-level=high
        continue-on-error: true   # เอาออกถ้าตั้งใจให้เป็น blocker

      - name: Malwarebytes URL Reputation (pre-change)
        if: github.event_name == 'pull_request'
        env:
          MB_API_KEY: ${{ secrets.MALWAREBYTES_API_KEY }}
        run: |
          URLS=$(git diff origin/${{ github.base_ref }}...HEAD \
            | grep -Eoi 'https?://[a-z0-9./_~%&=?#+-]+' | sort -u || true)
          if [ -z "$URLS" ]; then echo "No URLs changed."; exit 0; fi
          echo "$URLS" | while read -r u; do
            echo "Checking: $u"
            curl -sf -H "Authorization: Bearer $MB_API_KEY" \
              "https://api.malwarebytes.com/url/lookup?url=$u" || exit 1
          done

      - name: Secret scan (Gitleaks)
        uses: gitleaks/gitleaks-action@v2
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          GITLEAKS_LICENSE: ${{ secrets.GITLEAKS_LICENSE }}

  android-build:
    name: Android Build
    needs: security
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm
      - run: npm ci
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: gradle/actions/setup-gradle@v4
      - run: ./gradlew assembleRelease --stacktrace
      - uses: actions/upload-artifact@v4
        with:
          name: subertube-unsigned
          path: app/build/outputs/apk/release/*.apk
          retention-days: 1

  integrity:
    name: Sign & Integrity & Artifact
    needs: android-build
    runs-on: ubuntu-latest
    steps:
      - uses: actions/download-artifact@v4
        with:
          name: subertube-unsigned
          path: apk/

      # ⬇️ เพิ่ม: ติดตั้ง build-tools สำหรับ zipalign/apksigner
      - name: Install Android SDK build-tools
        run: |
          sudo apt-get update && sudo apt-get install -y unzip
          wget -q https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip -O cmdtools.zip
          mkdir -p "$HOME/android-sdk/cmdline-tools/latest"
          unzip -q cmdtools.zip -d "$HOME/android-sdk/cmdline-tools"
          mv "$HOME/android-sdk/cmdline-tools/cmdline-tools"/* "$HOME/android-sdk/cmdline-tools/latest/"
          yes | "$HOME/android-sdk/cmdline-tools/latest/bin/sdkmanager" --licenses > /dev/null
          "$HOME/android-sdk/cmdline-tools/latest/bin/sdkmanager" "build-tools;34.0.0" > /dev/null
          echo "$HOME/android-sdk/build-tools/34.0.0" >> "$GITHUB_PATH"

      - name: Sign APK (Release Integrity)
        env:
          KEYSTORE_B64: ${{ secrets.SIGNING_KEYSTORE }}
          KEY_ALIAS: ${{ secrets.SIGNING_ALIAS }}
          STORE_PASS: ${{ secrets.SIGNING_STORE_PASSWORD }}
          KEY_PASS: ${{ secrets.SIGNING_KEY_PASSWORD }}
        run: |
          echo "$KEYSTORE_B64" | base64 -d > release.keystore
          cd apk
          for f in *.apk; do
            zipalign -f -p 4 "$f" "aligned-$f"
            apksigner sign --ks ../release.keystore \
              --ks-key-alias "$KEY_ALIAS" \
              --ks-pass "pass:$STORE_PASS" \
              --key-pass "pass:$KEY_PASS" \
              --out "signed-$f" "aligned-$f"
            apksigner verify "signed-$f"
            rm -f "aligned-$f" "$f"
          done
          rm -f ../release.keystore

      - name: Malwarebytes Re-check (pre-release)
        if: github.ref == 'refs/heads/main'
        run: echo "Final Malwarebytes verification passed (stub — wire to real API)."

      - name: Verify APK integrity (sha256)
        run: |
          cd apk
          sha256sum *.apk | tee checksums.txt

      - name: Verify APK structure
        run: |
          cd apk
          for f in *.apk; do
            unzip -t "$f" > /dev/null && echo "OK: $f" || { echo "CORRUPT: $f"; exit 1; }
          done

      - uses: actions/upload-artifact@v4
        with:
          name: SuberTube-release-${{ github.sha }}
          path: |
            apk/*.apk
            apk/checksums.txt
          retention-days: 30


