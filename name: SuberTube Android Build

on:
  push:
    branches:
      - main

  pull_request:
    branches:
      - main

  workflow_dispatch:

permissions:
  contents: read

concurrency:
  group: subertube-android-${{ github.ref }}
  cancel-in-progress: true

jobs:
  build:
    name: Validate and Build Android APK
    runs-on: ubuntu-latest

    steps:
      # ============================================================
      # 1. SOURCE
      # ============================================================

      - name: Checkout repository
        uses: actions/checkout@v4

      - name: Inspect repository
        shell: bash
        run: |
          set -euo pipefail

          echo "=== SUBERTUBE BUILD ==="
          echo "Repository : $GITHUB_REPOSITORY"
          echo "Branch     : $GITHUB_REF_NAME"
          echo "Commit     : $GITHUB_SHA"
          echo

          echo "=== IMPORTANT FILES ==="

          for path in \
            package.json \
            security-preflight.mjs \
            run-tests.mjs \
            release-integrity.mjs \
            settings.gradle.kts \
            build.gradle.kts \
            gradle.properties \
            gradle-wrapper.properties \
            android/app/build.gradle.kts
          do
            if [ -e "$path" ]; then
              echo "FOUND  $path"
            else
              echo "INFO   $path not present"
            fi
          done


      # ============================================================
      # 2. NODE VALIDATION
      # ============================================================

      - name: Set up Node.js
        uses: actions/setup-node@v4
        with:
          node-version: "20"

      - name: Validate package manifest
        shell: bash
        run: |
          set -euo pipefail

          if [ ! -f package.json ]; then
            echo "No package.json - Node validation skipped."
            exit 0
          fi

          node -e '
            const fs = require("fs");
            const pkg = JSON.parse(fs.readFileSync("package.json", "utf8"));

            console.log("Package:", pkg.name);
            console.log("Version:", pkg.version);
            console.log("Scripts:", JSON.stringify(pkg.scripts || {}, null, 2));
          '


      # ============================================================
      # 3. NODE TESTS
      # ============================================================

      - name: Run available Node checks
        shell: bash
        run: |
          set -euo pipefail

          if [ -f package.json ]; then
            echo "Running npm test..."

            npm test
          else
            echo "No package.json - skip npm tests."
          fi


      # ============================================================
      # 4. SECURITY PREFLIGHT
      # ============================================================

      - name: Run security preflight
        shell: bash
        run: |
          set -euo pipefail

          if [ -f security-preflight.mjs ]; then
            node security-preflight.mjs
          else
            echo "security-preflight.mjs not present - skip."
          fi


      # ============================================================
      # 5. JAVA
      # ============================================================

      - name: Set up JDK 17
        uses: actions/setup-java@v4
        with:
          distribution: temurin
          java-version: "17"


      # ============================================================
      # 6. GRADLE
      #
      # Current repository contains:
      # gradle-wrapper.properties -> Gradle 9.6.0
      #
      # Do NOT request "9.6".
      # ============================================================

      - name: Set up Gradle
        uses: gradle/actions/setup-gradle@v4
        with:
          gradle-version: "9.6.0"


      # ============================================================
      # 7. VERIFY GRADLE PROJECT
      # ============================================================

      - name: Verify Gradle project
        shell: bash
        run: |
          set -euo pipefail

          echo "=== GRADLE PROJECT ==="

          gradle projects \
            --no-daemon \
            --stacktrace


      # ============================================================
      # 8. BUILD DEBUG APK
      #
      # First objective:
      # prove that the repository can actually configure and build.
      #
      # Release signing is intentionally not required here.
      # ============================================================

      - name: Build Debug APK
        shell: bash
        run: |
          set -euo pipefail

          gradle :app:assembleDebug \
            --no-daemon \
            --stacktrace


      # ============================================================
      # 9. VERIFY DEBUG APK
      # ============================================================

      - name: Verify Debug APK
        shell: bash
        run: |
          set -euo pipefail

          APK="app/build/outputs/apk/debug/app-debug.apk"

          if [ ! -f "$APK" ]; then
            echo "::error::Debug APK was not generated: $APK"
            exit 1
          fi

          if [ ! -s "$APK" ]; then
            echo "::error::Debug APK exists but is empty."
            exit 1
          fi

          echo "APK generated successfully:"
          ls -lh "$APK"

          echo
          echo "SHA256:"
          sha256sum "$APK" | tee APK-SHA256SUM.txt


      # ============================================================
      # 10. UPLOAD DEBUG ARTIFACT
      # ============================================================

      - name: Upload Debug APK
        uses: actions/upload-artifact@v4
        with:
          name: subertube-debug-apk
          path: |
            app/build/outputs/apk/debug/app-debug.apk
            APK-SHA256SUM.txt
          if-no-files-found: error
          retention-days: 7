name: SuberTube Android Build

on:
  push:
    branches:
      - main

  pull_request:
    branches:
      - main

  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: subertube-android-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build:
    name: Validate and Build Android APK
    runs-on: ubuntu-latest

    steps:
      # ============================================================
      # 1. SOURCE
      # ============================================================

      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Inspect repository
        shell: bash
        run: |
          set -euo pipefail

          echo "=== SUBERTUBE BUILD ==="
          echo "Repository : $GITHUB_REPOSITORY"
          echo "Branch     : $GITHUB_REF_NAME"
          echo "Commit     : $GITHUB_SHA"
          echo

          echo "=== IMPORTANT FILES ==="

          for path in \
            package.json \
            security-preflight.mjs \
            run-tests.mjs \
            release-integrity.mjs \
            settings.gradle.kts \
            build.gradle.kts \
            gradle.properties \
            gradle-wrapper.properties \
            android/app/build.gradle.kts
          do
            if [ -e "$path" ]; then
              echo "FOUND  $path"
            else
              echo "INFO   $path not present"
            fi
          done


      # ============================================================
      # 2. NODE VALIDATION
      # ============================================================

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "20"

      - name: Validate package manifest
        shell: bash
        run: |
          set -euo pipefail

          if [ ! -f package.json ]; then
            echo "No package.json - Node validation skipped."
            exit 0
          fi

          node -e '
            const fs = require("fs");
            const pkg = JSON.parse(fs.readFileSync("package.json", "utf8"));

            console.log("Package:", pkg.name);
            console.log("Version:", pkg.version);
            console.log("Scripts:", JSON.stringify(pkg.scripts || {}, null, 2));
          '


      # ============================================================
      # 3. NODE TESTS
      # ============================================================

      - name: Run available Node checks
        shell: bash
        run: |
          set -euo pipefail

          if [ -f package.json ]; then
            echo "Running npm test..."

            npm test
          else
            echo "No package.json - skip npm tests."
          fi


      # ============================================================
      # 4. SECURITY PREFLIGHT
      # ============================================================

      - name: Run security preflight
        shell: bash
        run: |
          set -euo pipefail

          if [ -f security-preflight.mjs ]; then
            node security-preflight.mjs
          else
            echo "security-preflight.mjs not present - skip."
          fi


      # ============================================================
      # 5. JAVA
      # ============================================================

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"


      # ============================================================
      # 6. GRADLE
      #
      # Current repository contains:
      # gradle-wrapper.properties -> Gradle 9.6.0
      #
      # Do NOT request "9.6".
      # ============================================================

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "9.6.0"


      # ============================================================
      # 7. VERIFY GRADLE PROJECT
      # ============================================================

      - name: Verify Gradle project
        shell: bash
        run: |
          set -euo pipefail

          echo "=== GRADLE PROJECT ==="

          gradle projects \
            --no-daemon \
            --stacktrace


      # ============================================================
      # 8. BUILD DEBUG APK
      #
      # First objective:
      # prove that the repository can actually configure and build.
      #
      # Release signing is intentionally not required here.
      # ============================================================

      - name: Build Debug APK
        shell: bash
        run: |
          set -euo pipefail

          gradle :app:assembleDebug \
            --no-daemon \
            --stacktrace


      # ============================================================
      # 9. VERIFY DEBUG APK
      # ============================================================

      - name: Verify Debug APK
        shell: bash
        run: |
          set -euo pipefail

          APK="app/build/outputs/apk/debug/app-debug.apk"

          if [ ! -f "$APK" ]; then
            echo "::error::Debug APK was not generated: $APK"
            exit 1
          fi

          if [ ! -s "$APK" ]; then
            echo "::error::Debug APK exists but is empty."
            exit 1
          fi

          echo "APK generated successfully:"
          ls -lh "$APK"

          echo
          echo "SHA256:"
          sha256sum "$APK" | tee APK-SHA256SUM.txt


      # ============================================================
      # 10. UPLOAD DEBUG ARTIFACT
      # ============================================================

      - name: Upload Debug APK
        uses: actions/upload-artifact@v4
        with:
          name: subertube-debug-apk
          path: |
            app/build/outputs/apk/debug/app-debug.apk
            APK-SHA256SUM.txt
          if-no-files-found: error
          retention-days: 7