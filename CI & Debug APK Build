name: CI & Debug APK Build

on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  quality-and-build:
    name: Quality Gate & Debug APK
    runs-on: ubuntu-latest

    steps:
      # -------------------------------------------------------------
      # 1. Checkout repository
      # -------------------------------------------------------------
      - name: Checkout repository
        uses: actions/checkout@v4

      # -------------------------------------------------------------
      # 2. Quality Gate: Node.js Tests & Security Preflight
      # (รันก่อนทุกขั้นตอน หากไม่ผ่านจะหยุดทันที ไม่เริ่มขั้นตอนสร้าง APK)
      # -------------------------------------------------------------
      - name: Set up Node.js 20
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Run Web Quality Gate & Preflight Checks
        run: |
          mkdir -p /tmp/clean-source
          git archive HEAD | tar -x -C /tmp/clean-source
          cd /tmp/clean-source
          
          echo "=== 1. Running Unit & Integration Tests ==="
          npm test
          
          echo "=== 2. Running Security Preflight ==="
          npm run security

      # -------------------------------------------------------------
      # 3. Android Build Environment Setup
      # -------------------------------------------------------------
      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '17'

      # ระบุ Gradle 9.6.0 ให้สอดคล้องกับ AGP 9.4.0 และติดตั้ง Gradle CLI ลงใน PATH
      - name: Setup Gradle 9.6.0
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '9.6.0'

      # -------------------------------------------------------------
      # 4. Build Debug APK (ไม่ใช้ Secrets ใด ๆ)
      # รองรับทั้งกรณีที่มี gradlew wrapper หรือไม่มี wrapper JAR ใน repo
      # -------------------------------------------------------------
      - name: Build Debug APK
        run: |
          if [ -f "./android/gradlew" ]; then
            echo "Building with local ./android/gradlew..."
            chmod +x ./android/gradlew
            ./android/gradlew -p android :app:assembleDebug --stacktrace --no-daemon
          else
            echo "gradlew not found; building directly with Gradle CLI 9.6.0..."
            gradle -p android :app:assembleDebug --stacktrace --no-daemon
          fi

      # -------------------------------------------------------------
      # 5. ตรวจสอบไฟล์ผลลัพธ์
      # -------------------------------------------------------------
      - name: Verify Debug APK Output
        run: |
          test -f android/app/build/outputs/apk/debug/app-debug.apk
          ls -lh android/app/build/outputs/apk/debug/app-debug.apk

      # -------------------------------------------------------------
      # 6. Upload Verified Debug APK
      # -------------------------------------------------------------
      - name: Upload Debug APK
        uses: actions/upload-artifact@v4
        with:
          name: subertube-debug-apk
          path: android/app/build/outputs/apk/debug/app-debug.apk
          retention-days: 7
          if-no-files-found: error

      # -------------------------------------------------------------
      # 7. Cleanup
      # -------------------------------------------------------------
      - name: Cleanup temporary directories
        if: always()
        run: |
          rm -rf /tmp/clean-source