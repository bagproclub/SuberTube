name: Android Release Build

on:
  workflow_dispatch:

  push:
    branches:
      - main

permissions:
  contents: read

concurrency:
  group: android-release-${{ github.ref }}
  cancel-in-progress: true

jobs:
  release:
    name: Build Release APK
    runs-on: ubuntu-latest

    steps:
      # ============================================================
      # 1. SOURCE
      # ============================================================

      - name: Checkout
        uses: actions/checkout@v4

      # ============================================================
      # 2. OPTIONAL NODE CHECK
      # ============================================================

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Run security preflight
        shell: bash
        run: |
          set -e

          if [ -f "security-preflight.mjs" ]; then
            node security-preflight.mjs
          else
            echo "security-preflight.mjs not found - skip"
          fi

      # ============================================================
      # 3. ANDROID ENVIRONMENT
      # ============================================================

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "9.6"

      # ============================================================
      # 4. DETECT GRADLE PROJECT
      # ============================================================

      - name: Detect Android project
        shell: bash
        run: |
          set -e

          if [ -f "android/gradlew" ]; then
            echo "GRADLE_DIR=android" >> "$GITHUB_ENV"
            echo "GRADLE_CMD=./gradlew" >> "$GITHUB_ENV"

          elif [ -f "gradlew" ]; then
            echo "GRADLE_DIR=." >> "$GITHUB_ENV"
            echo "GRADLE_CMD=./gradlew" >> "$GITHUB_ENV"

          elif [ -f "android/settings.gradle.kts" ] || \
               [ -f "android/settings.gradle" ]; then
            echo "GRADLE_DIR=android" >> "$GITHUB_ENV"
            echo "GRADLE_CMD=gradle" >> "$GITHUB_ENV"

          elif [ -f "settings.gradle.kts" ] || \
               [ -f "settings.gradle" ]; then
            echo "GRADLE_DIR=." >> "$GITHUB_ENV"
            echo "GRADLE_CMD=gradle" >> "$GITHUB_ENV"

          else
            echo "::error::Gradle project not found"
            exit 1
          fi

          echo "Gradle directory: $GRADLE_DIR"
          echo "Gradle command: $GRADLE_CMD"

      # ============================================================
      # 5. BUILD
      # ============================================================

      - name: Build Release APK
        shell: bash
        env:
          KEYSTORE_PATH: ${{ secrets.KEYSTORE_PATH }}
          KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
          KEY_PASSWORD: ${{ secrets.KEY_PASSWORD }}
        run: |
          set -e

          cd "$GRADLE_DIR"

          if [ "$GRADLE_CMD" = "./gradlew" ]; then
            chmod +x ./gradlew
          fi

          "$GRADLE_CMD" :app:assembleRelease \
            --no-daemon \
            --stacktrace

      # ============================================================
      # 6. FIND APK
      # ============================================================

      - name: Find Release APK
        shell: bash
        run: |
          set -e

          APK=$(find . \
            -type f \
            -path "*/build/outputs/apk/release/*.apk" \
            | head -n 1)

          if [ -z "$APK" ]; then
            echo "::error::Release APK was not generated"
            exit 1
          fi

          echo "APK=$APK" >> "$GITHUB_ENV"

          echo "Release APK:"
          ls -lh "$APK"

      # ============================================================
      # 7. INTEGRITY
      # ============================================================

      - name: Generate SHA256
        shell: bash
        run: |
          set -e

          sha256sum "$APK" | tee RELEASE-SHA256SUMS.txt

      - name: Verify APK
        shell: bash
        run: |
          set -e

          if [ ! -s "$APK" ]; then
            echo "::error::APK is missing or empty"
            exit 1
          fi

          echo "APK verification: PASS"
          echo
          echo "SHA256:"
          cat RELEASE-SHA256SUMS.txt

      # ============================================================
      # 8. ARTIFACT
      # ============================================================

      - name: Upload Release Artifact
        uses: actions/upload-artifact@v4
        with:
          name: app-release
          path: |
            ${{ env.APK }}
            RELEASE-SHA256SUMS.txt
          if-no-files-found: error
          retention-days: 14